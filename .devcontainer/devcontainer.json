{
    "name": "pg_parquet Dev Environment",
    "dockerComposeFile": "docker-compose.yml",
    "service": "pg_parquet",
    "workspaceFolder": "/workspace",
    "remoteUser": "rust",
    "containerUser": "rust",
    "customizations": {
        "vscode": {
            "extensions": [
                "vadimcn.vscode-lldb",
                "GitHub.copilot",
                "eamodio.gitlens",
                "bradymholt.pgformatter",
                "rust-lang.rust-analyzer",
                "ms-vscode.cpptools",
                "henriiik.docker-linter"
            ]
        }
    }
}
